      <pou name="C_Pragma" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="TRIG">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="IN">
              <type>
                <INT/>
              </type>
            </variable>
          </inputVars>
          <localVars>
            <variable name="rtrig">
              <type>
                <derived name="R_TRIG"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[rtrig(CLK := TRIG);
IF rtrig.Q THEN 
{{
  short inval = GetFbVar(IN);
  printf("C runtime OK #%d\n", inval);
  fflush(stdout);
}}
END_IF;
]]></xhtml:p>
          </ST>
        </body>
