FUNCTION_BLOCK CounterSFC
  VAR_INPUT
    Reset : BOOL;
  END_VAR
  VAR_OUTPUT
    OUT : INT;
  END_VAR
  VAR
    Cnt : INT;
  END_VAR
  VAR_EXTERNAL CONSTANT
    ResetCounterValue : INT;
  END_VAR
  INITIAL_STEP #1 Start AT (241, 14) SIZE (90, 34)
    OUT => AT (45, 34);
  END_STEP
  SELECTION_DIVERGENCE #2 AT (70, 86) SIZE (431, 1)
    IN AT (216, 0) := #1 VIA (286, 86), (286, 42);
    OUT => AT (0, 1);
    OUT => AT (431, 1);
  END_SELECTION_DIVERGENCE
  TRANSITION #3 AT (491, 132) SIZE (20, 2)
    IN AT (10, 0) := #2 VIA (501, 132), (501, 87);
    OUT => AT (10, 2);
    CONDITION := Reset;
  END_TRANSITION
  TRANSITION #4 (executionOrderId := 0) AT (60, 135) SIZE (20, 2)
    IN AT (10, 0) := #2 VIA (70, 135), (70, 87);
    OUT => AT (10, 2);
    CONDITION := NOT Reset;
  END_TRANSITION
  STEP #5 ResetCounter AT (434, 190) SIZE (134, 30)
    IN AT (67, 0) := #3 VIA (501, 190), (501, 134);
    OUT => AT (67, 30);
    OUT_ACTION => AT (134, 15);
  END_STEP
  ACTION_BLOCK #6 AT (641, 190) SIZE (254, 63)
    IN AT (0, 15) := #5 VIA (641, 205), (568, 205);
    ACTION (N) Cnt := ResetCounterValue; END_ACTION
    ACTION (N) OUT := Cnt; END_ACTION
  END_ACTION_BLOCK
  STEP #7 (executionOrderId := 0) Count AT (28, 191) SIZE (85, 30)
    IN AT (42, 0) := #4 VIA (70, 191), (70, 137);
    OUT => AT (42, 30);
    OUT_ACTION => AT (85, 15);
  END_STEP
  ACTION_BLOCK #8 (executionOrderId := 0) AT (154, 191) SIZE (164, 52)
    IN AT (0, 15) := #7 VIA (154, 206), (113, 206);
    ACTION (N) Cnt := Cnt + 1; END_ACTION
    ACTION (N) OUT := Cnt; END_ACTION
  END_ACTION_BLOCK
  SELECTION_CONVERGENCE #10 AT (70, 273) SIZE (431, 1)
    IN AT (0, 0) := #13 VIA (70, 273), (70, 244);
    IN AT (431, 0) := #14 VIA (501, 273), (501, 250);
    OUT => AT (216, 1);
  END_SELECTION_CONVERGENCE
  JUMP_STEP #12 Start AT (280, 317) SIZE (12, 13)
    IN AT (6, 0) := #10 VIA (286, 317), (286, 274);
  END_JUMP_STEP
  TRANSITION #13 (executionOrderId := 0) AT (60, 242) SIZE (20, 2)
    IN AT (10, 0) := #7 VIA (70, 242), (70, 215);
    OUT => AT (10, 2);
    CONDITION := Reset;
  END_TRANSITION
  TRANSITION #14 (executionOrderId := 0) AT (491, 248) SIZE (20, 2)
    IN AT (10, 0) := #5 VIA (501, 248), (501, 220);
    OUT => AT (10, 2);
    CONDITION := NOT Reset;
  END_TRANSITION
END_FUNCTION_BLOCK
